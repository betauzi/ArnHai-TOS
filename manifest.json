{
  "manifest_version": 3,
  "name": "อ่านให้ (Arn-Hai) — ToS + Scam Analyzer",
  "short_name": "อ่านให้",
  "version": "1.2.0",
  "description": "วิเคราะห์ Terms of Service พร้อม Risk Score + ตรวจ Scam หลอกลงทุน Romance Scam Phishing และ Job Scam — ขับเคลื่อนด้วย Google Gemini AI",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "อ่านให้ — ToS + Scam Analyzer"
  },

  "options_page": "options/options.html",

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}
